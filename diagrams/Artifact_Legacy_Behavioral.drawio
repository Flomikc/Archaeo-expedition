        <mxCell id="m3" value="3: place()" style="endArrow=open;html=1;fontSize=11;exitX=0.4;exitY=1;entryX=0.4;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objBurC" target="objBur"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m4" value="4: OK, бур установлен" style="endArrow=open;html=1;fontSize=11;exitX=0.7;exitY=1;entryX=0.7;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objBur" target="objBurC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m5" value="5: начатьРаскопки() (по E)" style="endArrow=open;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objPlayer" target="objBur"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="260" /><mxPoint x="800" y="260" /></Array></mxGeometry></mxCell>
        <mxCell id="m6" value="6: startDrilling(), state = Drilling" style="endArrow=open;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objBur" target="objBurC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m7" value="7: начатьСпавн(этаж)" style="endArrow=open;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objBurC" target="objAI"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m8" value="8: create()" style="endArrow=open;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objAI" target="objAnom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m9" value="9: атаковать(бур)" style="endArrow=open;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objAnom" target="objBur"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m10" value="10: сделатьСнимок(аномалия)" style="endArrow=open;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objPlayer" target="objCam"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="500" /><mxPoint x="150" y="600" /></Array></mxGeometry></mxCell>
        <mxCell id="m11" value="11: onPhoto()" style="endArrow=open;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objCam" target="objAnom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="584" /><mxPoint x="620" y="480" /><mxPoint x="1140" y="480" /></Array></mxGeometry></mxCell>
        <mxCell id="m12" value="12: уничтожена" style="endArrow=open;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objAnom" target="objAI"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m13" value="13: complete()" style="endArrow=open;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objBur" target="objBurC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m14" value="14: артефактыГотовы()" style="endArrow=open;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.8;entryY=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objBurC" target="objExp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="160" /><mxPoint x="520" y="160" /></Array></mxGeometry></mxCell>
        <mxCell id="m15" value="15: сохранитьПрогресс(player)" style="endArrow=open;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.3;entryY=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objExp" target="objSave"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="480" /><mxPoint x="1100" y="480" /></Array></mxGeometry></mxCell>

        <mxCell id="noteC" value="&lt;b&gt;Сценарий:&lt;/b&gt; игрок устанавливает бур в финальной комнате, запускает раскопки, AI спавнит аномалию, игрок фотографирует её, бур завершает работу, артефакты готовы, прогресс сохраняется.&lt;br&gt;&lt;b&gt;8 объектов, 15 сообщений.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Ключевое:&lt;/b&gt; сообщения 3, 4, 6, 13 — прямое взаимодействие BurController ↔ Bur; сообщение 9 — атака аномалии на бур; сообщения 10–12 — фотоохота, замкнутая цепочка Player → PhotoCamera → Anomaly → AnomalyAI." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=8;whiteSpace=wrap;fillColor=#eaf3ff;strokeColor=#7ea6d4;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1200" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
