        <mxCell id="m1" value="1: установитьБур(финальнаяКомната)" style="endArrow=open;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="objPlayer" target="objExp"><mxGeometry relative="1" as="geometry" /></mxCell>
