              <mxPoint x="1320" y="700" />
              <mxPoint x="1320" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;Назначение DFD L0:&lt;/b&gt; показать систему как единый процесс «0. Артефакт: Наследие» и её взаимодействие с четырьмя внешними сущностями. Игрок отправляет управление и получает визуальный отклик; браузер/WebGL исполняет рендер и физику; localStorage хранит и возвращает прогресс; Яндекс Игры SDK (перспектива, пунктир) отвечает за rewarded video и лидерборды. Сетевых потоков данных игрока нет — вся логика выполняется локально в браузере." style="text;html=1;align=left;verticalAlign=top;fontSize=14;spacingLeft=8;spacingTop=8;whiteSpace=wrap;fillColor=#eaf3ff;strokeColor=#7ea6d4;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="820" width="1400" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

