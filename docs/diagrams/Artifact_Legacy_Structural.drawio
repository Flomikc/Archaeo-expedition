          <mxGeometry x="680" y="284" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cdnManifest" value="manifest.json (иконки, метаданные)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
