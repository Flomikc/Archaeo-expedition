        </mxCell>
        <mxCell id="cdnSize" value="Общий размер архива ≤ 100 МБ (лимит Яндекс Игр)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#82b366;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="408" width="380" height="50" as="geometry" />
