        </mxCell>
        <mxCell id="sdkAuth" value="Auth / Player data API" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1180" y="284" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="HTTPS — загрузка статики (при старте игры)" style="endArrow=open;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="nodeClient" target="nodeCDN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="WebGL API — вызовы к GPU (локально, без сети)" style="endArrow=open;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="kCanvas" target="kGPU">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="localStorage API — чтение/запись прогресса (same-origin, без сети)" style="endArrow=open;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="kLS" target="kTS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="«HTTPS / REST (SDK)» — только при интеграции с Яндекс Играми (перспектива)" style="endArrow=open;dashed=1;html=1;fontSize=11;fontColor=#666666;strokeColor=#999999;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.85;entryX=0;entryY=0.85;" edge="1" parent="1" source="nodeClient" target="nodeSDK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="desc" value="&lt;b&gt;Три узла:&lt;/b&gt; (1) устройство пользователя с браузером, где выполняется весь код, работает WebGL и хранится localStorage; (2) статический CDN Яндекс Игр, откуда загружаются бандлы и ассеты; (3) платформа Яндекс Игр (пунктир, перспектива) для rewarded video, лидербордов и синхронизации.&lt;br&gt;&lt;b&gt;Протоколы:&lt;/b&gt; HTTPS для загрузки статики; WebGL (локально, к GPU); localStorage API (локально, без сети); HTTPS/REST (SDK, только при интеграции с Яндекс Играми).&lt;br&gt;&lt;b&gt;Ключевое решение:&lt;/b&gt; вся игровая логика выполняется на клиенте, сервер нужен только для раздачи статики. Данные игрока не покидают устройство до момента интеграции с SDK Яндекс Игр." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=8;whiteSpace=wrap;fillColor=#eaf3ff;strokeColor=#7ea6d4;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="1480" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
