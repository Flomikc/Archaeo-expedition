        <mxCell id="e33" edge="1" parent="1" source="a20" style="endArrow=open;html=1;fontSize=20;" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noteAct" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=20;spacingLeft=8;spacingTop=8;whiteSpace=wrap;fillColor=#eaf3ff;strokeColor=#7ea6d4;rounded=1;" value="&lt;b&gt;Параллелизм:&lt;/b&gt; после Fork одновременно идут ветка «Раскопки» (таймер) и ветка «Спавн и защита от аномалий». Join синхронизирует обе ветви перед проверкой HP бура.&lt;br&gt;&lt;b&gt;Альтернативные сценарии:&lt;/b&gt; неудачный взлом (повтор/отмена), успешная фотоохота, урон по буру, провал экспедиции.&lt;br&gt;&lt;b&gt;Параллельная обработка нескольких аномалий&lt;/b&gt; может давать несколько итераций, но результат сходится в одну точку Join." vertex="1">
          <mxGeometry height="530" width="260" x="120" y="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
